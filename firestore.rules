rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All real reads/writes go through authenticated Next.js API routes
    // and server components using the Firebase Admin SDK, which bypasses
    // these rules entirely. Direct client-side access from the browser is
    // denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
