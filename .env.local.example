# Copy this file to .env.local and fill in real values for local development.
# In production (Firebase App Hosting), these are set as secrets — see
# apphosting.yaml and the README's deployment section. Never commit
# .env.local or real secret values.

# Firebase Admin SDK (server-side only). Paste the full service account JSON
# as a single-line string, e.g. via `jq -c . service-account.json`.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase client SDK config (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Stripe (use test-mode keys until the whole flow is verified)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret the marketing site's contact-form backend must send in the
# `x-intake-secret` header when POSTing to /api/public/intake. Generate a
# long random value and keep it out of any client-side code.
INTAKE_API_SECRET=

# Optional: if set, Jenna gets a short notification email at this address
# whenever a new inbound message arrives.
NOTIFY_EMAIL=
